{
  "name": "lecunity",
  "version": "3.2.0",
  "description": "AI-powered learning platform that transforms audio and video lectures into transcripts, summaries, and structured study notes.",
  "author": "Lecunity",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uxasad/Lecunity.git"
  },
  "keywords": [
    "lecunity",
    "artificial-intelligence",
    "lecture-notes",
    "transcription",
    "groq",
    "whisper",
    "nextjs",
    "education",
    "urdu",
    "roman-urdu",
    "summarization"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:debug": "playwright test --debug",
    "check:ffmpeg": "bash scripts/check-ffmpeg.sh",
    "find:ffmpeg": "bash scripts/find-ffmpeg.sh"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.2",
    "formidable": "^3.5.1",
    "marked": "^15.0.12",
    "next": "^15.5.29",
    "openai": "^4.28.0",
    "p-retry": "^7.1.1",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-starry-night": "^2.2.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/formidable": "^3.4.5",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "autoprefixer": "^10.4.17",
    "baseline-browser-mapping": "^2.11.39",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^27.4.0",
    "node-mocks-http": "^1.17.2",
    "playwright": "^1.57.0",
    "postcss": "^8.4.33",
    "prettier": "^3.2.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": "22.x",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "caniuse-lite": "1.0.30001828"
    }
  }
}
